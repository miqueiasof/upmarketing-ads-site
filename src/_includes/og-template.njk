<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
  @font-face { font-family: 'Instrument Serif'; src: url('{{fonts}}instrument-serif-400-latin.woff2') format('woff2'); }
  @font-face { font-family: 'Space Grotesk'; src: url('{{fonts}}space-grotesk-400-latin.woff2') format('woff2'); }
  @font-face { font-family: 'IBM Plex Mono'; font-weight: 500; src: url('{{fonts}}ibm-plex-mono-500-latin.woff2') format('woff2'); }
  * { margin: 0; box-sizing: border-box; }
  html, body { width: 1200px; height: 630px; background: #0A1428; color: #EEF2F8; overflow: hidden; }
  .card { position: relative; width: 1200px; height: 630px; padding: 72px 80px 64px; display: flex; flex-direction: column; justify-content: space-between; }
  .kicker { font: 500 20px/1 'IBM Plex Mono'; letter-spacing: .14em; text-transform: uppercase; color: #3DE8C8; }
  .title { font: 400 {{titleSize}}px/1.05 'Instrument Serif'; max-width: 700px; letter-spacing: -.01em; margin-top: 28px; }
  .sub { font: 400 24px/1.35 'Space Grotesk'; color: #7C8BA3; max-width: 680px; margin-top: 22px; }
  .brand { display: flex; justify-content: space-between; align-items: baseline; font: 500 18px/1 'IBM Plex Mono'; letter-spacing: .14em; text-transform: uppercase; color: #7C8BA3; }
  .brand b { color: #EEF2F8; font-weight: 500; font-size: 26px; letter-spacing: .02em; margin-right: 10px; }
  .diagram { position: absolute; right: 72px; top: 50%; transform: translateY(-50%); width: 300px; height: 300px; }
  .diagram line { stroke: rgba(238,242,248,.18); stroke-width: 1.5; }
  .diagram circle { fill: #0D1830; stroke: rgba(238,242,248,.26); stroke-width: 1.5; }
  .diagram .core { fill: rgba(61,232,200,.14); stroke: #3DE8C8; }
  .glow { position: absolute; right: -120px; top: -140px; width: 520px; height: 520px; border-radius: 50%; background: radial-gradient(circle, rgba(61,232,200,.16), rgba(61,232,200,0) 62%); }
</style>
</head>
<body>
<div class="card">
  <div class="glow"></div>
  <div>
    <p class="kicker">{{kicker}}</p>
    <h1 class="title">{{title}}</h1>
    <p class="sub">{{sub}}</p>
  </div>
  <div class="brand"><span><b>UP</b> Marketing Ads</span><span>upmarketingads.com</span></div>
  <svg class="diagram" viewBox="0 0 300 300" aria-hidden="true">
    <line x1="150" y1="150" x2="150" y2="30"/><line x1="150" y1="150" x2="254" y2="90"/><line x1="150" y1="150" x2="254" y2="210"/>
    <line x1="150" y1="150" x2="150" y2="270"/><line x1="150" y1="150" x2="46" y2="210"/><line x1="150" y1="150" x2="46" y2="90"/>
    <line x1="150" y1="30" x2="254" y2="90"/><line x1="254" y1="210" x2="150" y2="270"/><line x1="46" y1="210" x2="46" y2="90"/>
    <circle cx="150" cy="30" r="16"/><circle cx="254" cy="90" r="16"/><circle cx="254" cy="210" r="16"/>
    <circle cx="150" cy="270" r="16"/><circle cx="46" cy="210" r="16"/><circle cx="46" cy="90" r="16"/>
    <circle class="core" cx="150" cy="150" r="34"/>
  </svg>
</div>
</body>
</html>
