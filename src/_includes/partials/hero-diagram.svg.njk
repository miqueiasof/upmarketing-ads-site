{#- 6 service nodes on a ring around the core. Positions: angle -90° + i·60°, radius 170, centre (320,240). -#}
{%- set nodes = [
  { x: 320, y: 70,  lx: 320, ly: 22,  anchor: 'middle' },
  { x: 467, y: 155, lx: 512, ly: 150, anchor: 'start' },
  { x: 467, y: 325, lx: 512, ly: 330, anchor: 'start' },
  { x: 320, y: 410, lx: 320, ly: 466, anchor: 'middle' },
  { x: 173, y: 325, lx: 128, ly: 330, anchor: 'end' },
  { x: 173, y: 155, lx: 128, ly: 150, anchor: 'end' }
] -%}
<svg class="diagram" viewBox="0 0 640 480" role="img" aria-label="{{ t.hero.diagramCore }}" data-drawn="false">
  <g class="edges" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round">
    {%- for n in nodes %}
    <path class="edge edge--spoke" d="M320 240 L{{ n.x }} {{ n.y }}"/>
    {%- endfor %}
    <path class="edge edge--chord" d="M{{ nodes[0].x }} {{ nodes[0].y }} L{{ nodes[2].x }} {{ nodes[2].y }}"/>
    <path class="edge edge--chord" d="M{{ nodes[2].x }} {{ nodes[2].y }} L{{ nodes[4].x }} {{ nodes[4].y }}"/>
    <path class="edge edge--chord" d="M{{ nodes[4].x }} {{ nodes[4].y }} L{{ nodes[0].x }} {{ nodes[0].y }}"/>
  </g>
  {%- for n in nodes %}
  <g class="node" data-node="{{ t.services[loop.index0].slug }}">
    <circle cx="{{ n.x }}" cy="{{ n.y }}" r="34" class="node__disc"/>
    <text x="{{ n.x }}" y="{{ n.y + 4 }}" text-anchor="middle" class="node__num">0{{ loop.index }}</text>
    <text x="{{ n.lx }}" y="{{ n.ly }}" text-anchor="{{ n.anchor }}" class="node__label">{{ t.hero.nodes[loop.index0] }}</text>
  </g>
  {%- endfor %}
  <g class="node node--core">
    <circle cx="320" cy="240" r="48" class="node__disc node__disc--core"/>
    <text x="320" y="236" text-anchor="middle" class="node__core-label">{{ t.hero.nodes[6] }}</text>
    <text x="320" y="252" text-anchor="middle" class="node__core-label">{{ t.hero.nodes[7] }}</text>
  </g>
</svg>
