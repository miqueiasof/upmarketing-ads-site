<section class="section cta-final" id="contact">
  <div class="container">
    <div class="section__head reveal">
      <span class="section__num">{{ t.cta.num }}</span>
      <h2>{{ t.cta.h2 }}</h2>
    </div>
    <p class="muted section__intro reveal">{{ t.cta.text }}</p>
    <a class="btn btn--primary reveal" href="{{ diagnosisPath or '/diagnosis/' }}">{{ t.cta.button }}</a>
  </div>
</section>
