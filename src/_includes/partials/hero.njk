<section class="hero" id="top">
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="mono hero__kicker">{{ t.hero.kicker }}</p>
      <h1 class="hero__h1">{{ t.hero.h1a }} <em>{{ t.hero.h1b }}</em></h1>
      <p class="hero__sub">{{ t.hero.sub }}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="{{ diagnosisPath or '/diagnosis/' }}">{{ t.hero.cta }}</a>
        <a class="btn btn--ghost" href="#services">{{ t.hero.cta2 }}</a>
      </div>
    </div>
    <div class="hero__diagram" aria-hidden="true">
      <div class="hero-diagram" data-core="{{ t.hero.diagramCore }}"></div>
    </div>
  </div>
</section>
